ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Local dev (default): SQLite, a single file, zero setup.
DATABASE_URL=sqlite:///./ministry_dashboard.db
# Production (e.g. Render): point at a real Postgres instead — SQLite has no
# persistent disk on Render's free tier and would reset on every redeploy.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. Only used by `python -m app.check_sources --fetch` to pull CPI data
# from data.gov.in. Everything works without it — the curated CSVs are the
# source of truth.
DATA_GOV_IN_API_KEY=

# Optional, production only. Comma-separated extra origins allowed to call this
# API (your deployed frontend's URL) on top of the localhost defaults.
# CORS_ORIGINS=https://your-app.vercel.app
